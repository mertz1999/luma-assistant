API_PORT=9001
WEB_PORT=5175
HOST=0.0.0.0
CODEX_PATH=codex
DEFAULT_RUNNER=codex
PASSWORD=change_me
JWT_SECRET=change_me_too
AUTH_TOKEN_TTL_SECONDS=86400
TASK_MANAGER_ADMIN_USERNAME=admin
TASK_MANAGER_ADMIN_PASSWORD=
TASK_MANAGER_JWT_SECRET=change_task_manager_secret
TASK_MANAGER_TOKEN_TTL_SECONDS=604800
TASK_MANAGER_DEFAULT_TIME_ZONE=Asia/Tehran
DEFAULT_MODEL=gpt-5.6-sol
CLAUDE_DEFAULT_MODEL=sonnet
DEFAULT_CURSOR_MODEL=composer-2.5
DEFAULT_REASONING_EFFORT=high
CLAUDE_CODE_EXECUTABLE=
CLAUDE_AUTH_MODE=oauth
# Cursor Agent CLI (third runner). Install Cursor CLI and set CURSOR_API_KEY.
# CURSOR_PATH=/usr/local/bin/cursor
# CURSOR_API_KEY=cursor_...
# CURSOR_FORCE=1
# CURSOR_APPROVE_MCPS=1
# CURSOR_WORKTREE=0
DEFAULT_SANDBOX=danger-full-access
# When the server runs as root (typical production), allow Claude bypassPermissions:
# CLAUDE_BYPASS_AS_ROOT=1
# Legacy compatibility also supported:
# DEFAULT_SANDBOX_TYPE=workspaceWrite
# DEFAULT_NETWORK_ACCESS=true
# Max browser attachment upload size in bytes. The Nginx example uses 20m so
# the proxy stays above this app-level limit.
# ATTACHMENT_MAX_BYTES=15728640
# Terminal PTY behavior:
# TERMINAL_DISABLE_PTY=1   # force plain pipes
# TERMINAL_SHELL=/bin/bash # optional explicit shell path
MAX_CONCURRENT_RUNS=8
# Memory / retention (keeps long-lived API process from growing for days):
# MESSAGE_STORE_HOT_SESSIONS=48
# RUN_EVENTS_MEMORY_CAP=400
# RUN_RETENTION_DAYS=45

# Telegram MCP:
# TELEGRAM_BOT_TOKEN=123456:abc...
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_MESSAGE_FILE_THREAD_ID=42
# TELEGRAM_MESSAGE_TEXT_THREAD_ID=43
# TELEGRAM_MCP_PORT=9013
# TELEGRAM_MCP_NAME=luma-tel
# Hosted api.telegram.org downloads are limited to 20 MB. For larger files,
# point both values at a self-hosted Telegram Bot API server.
# TELEGRAM_API_BASE=http://127.0.0.1:8081
# TELEGRAM_FILE_BASE=http://127.0.0.1:8081
# TELEGRAM_ALLOWED_ROOTS=/Users/applestation/Project
# TELEGRAM_MAX_FILE_BYTES=52428800

# Luma Tasks MCP (opt-in; off by default to save CPU/RAM):
# ENABLE_TASK_MANAGER_MCP=1
# TASK_MANAGER_MCP_PORT=9014
# TASK_MANAGER_MCP_NAME=luma-tasks
# LUMA_TASKS_API_BASE=http://127.0.0.1:9001
# LUMA_TASKS_USERNAME=admin
# LUMA_TASKS_PASSWORD=
# LUMA_TASKS_AUTH_TOKEN=

# Luma Images MCP:
# IMAGE_MCP_PORT=9015
# IMAGE_MCP_NAME=luma-images
# IMAGE_MCP_MAX_BYTES=3145728
# IMAGE_MCP_MAX_HEIGHT=1200
# LUMA_IMAGE_API_BASE=http://127.0.0.1:9001
# LUMA_IMAGE_PASSWORD=

# PI Clarification — safe test defaults. No live mail sending is authorized.
PI_CLARIFICATION_ENABLED=false
PI_CLARIFICATION_MODE=draft_only
# Deployment lock cannot be changed by the UI/model. Keep true throughout testing.
PI_CLARIFICATION_SEND_LOCK=true
PI_GMAIL_MAILBOX=admin@proimagetx.ai
PI_GMAIL_POLL_SECONDS=120
PI_GMAIL_CLIENT_ID=
PI_GMAIL_CLIENT_SECRET=
# Exact registered server callback (use your app origin):
PI_GMAIL_REDIRECT_URI=http://localhost:5175/api/cowork/pi-clarification/gmail/oauth/callback
# 64 hex characters: openssl rand -hex 32; store securely, separate from SQLite backups.
PI_CREDENTIAL_ENCRYPTION_KEY=
# Optional one-time injected refresh token; encrypted into SQLite at startup, then remove env entry.
PI_GMAIL_REFRESH_TOKEN=
# Optional Pub/Sub push. Without these, polling works independently of the browser.
PI_GMAIL_PUBSUB_TOPIC=
PI_GMAIL_PUBSUB_AUDIENCE=
PI_GMAIL_PUBSUB_SERVICE_ACCOUNT=
# Disabled unless separately authorized; scope gmail.compose is not requested by the default OAuth flow.
PI_GMAIL_ALLOW_DRAFT_WRITES=false
# Isolated JSON model endpoint; no coding CLI, shell or MCP tool privileges.
PI_REASONER_URL=
PI_REASONER_API_KEY=
# Optional independently isolated read-only investigation endpoint and server-side bearer credential.
PI_INVESTIGATOR_URL=
PI_INVESTIGATOR_API_KEY=
PI_INVESTIGATOR_READONLY_VERIFIED=false
# Direct safe reasoning option: anthropic (Messages API) or json_http (custom isolated provider).
# Anthropic only emits one structured proposal; no provider tools or coding CLI are executed.
PI_REASONER_PROVIDER=json_http
PI_REASONER_MODEL=
PI_ANTHROPIC_API_KEY=
# Optional existing PI Auth0/Google WIF credentials in a private (0600) server-side JSON file.
# This adapter only requests Gmail read-only access and cannot send/create drafts.
PI_GMAIL_FEDERATION_CREDENTIALS_FILE=
# Production inbox scope: exact From address in at least one actual thread message.
# This is an application guard; Google's readonly token itself is mailbox-wide.
# Comma-separated addresses; any one actual From address qualifies. Overrides legacy singular setting.
PI_GMAIL_REQUIRED_THREAD_SENDERS=
# Legacy single-sender configuration (used if the plural setting is empty).
PI_GMAIL_REQUIRED_THREAD_SENDER=
# Explicit local receipt without invoking a model or sending mail.
PI_CLARIFICATION_RECEIVE_ONLY=false
# Set false to disable replay/simulator routes and hide demo controls on a live installation.
PI_CLARIFICATION_DEMO_ENABLED=true
