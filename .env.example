API_PORT=9001
WEB_PORT=5175
HOST=0.0.0.0
CODEX_PATH=codex
DEFAULT_RUNNER=codex
PASSWORD=change_me
JWT_SECRET=change_me_too
AUTH_TOKEN_TTL_SECONDS=86400
TASK_MANAGER_ADMIN_USERNAME=admin
TASK_MANAGER_ADMIN_PASSWORD=
TASK_MANAGER_JWT_SECRET=change_task_manager_secret
TASK_MANAGER_TOKEN_TTL_SECONDS=604800
TASK_MANAGER_DEFAULT_TIME_ZONE=Asia/Tehran
DEFAULT_MODEL=gpt-5.3-codex
CLAUDE_DEFAULT_MODEL=sonnet
DEFAULT_REASONING_EFFORT=high
CLAUDE_CODE_EXECUTABLE=
CLAUDE_AUTH_MODE=oauth
DEFAULT_SANDBOX=danger-full-access
# Legacy compatibility also supported:
# DEFAULT_SANDBOX_TYPE=workspaceWrite
# DEFAULT_NETWORK_ACCESS=true
# Max browser attachment upload size in bytes. The Nginx example uses 20m so
# the proxy stays above this app-level limit.
# ATTACHMENT_MAX_BYTES=15728640
# Terminal PTY behavior:
# TERMINAL_DISABLE_PTY=1   # force plain pipes
# TERMINAL_SHELL=/bin/bash # optional explicit shell path
MAX_CONCURRENT_RUNS=8

